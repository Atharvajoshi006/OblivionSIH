# =====================================================================
# GeoOre-AI Git Ignore
# =====================================================================

# 1. Environments & Dependencies
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# 2. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg

# 3. Secrets, Credentials & API Keys
.env
.env.*
!.env.example
*.token
*.pem
*.key
credentials.json
secrets.json

# 4. Large Geospatial Data & Satellite Imagery
# (Raw satellite scenes, large GeoTIFF rasters, and downloads should not bloat Git)
data/raw/
*.SAFE/
*.tif
*.tiff
*.nc
*.hdf
*.grib
*.zip
*.tar.gz

# Runtime API cache
data/processed/environmental_cache.json

# 5. Testing & Code Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# 6. Jupyter Notebooks
.ipynb_checkpoints
*-checkpoint.ipynb

# 7. IDEs & Editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# 8. Operating System Junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 9. Logs & Runtime Scratch Outputs
*.log
logs/
outputs/*
!outputs/.gitkeep
scratch/
.system_generated/
